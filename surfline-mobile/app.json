{
  "expo": {
    "name": "MeteoSurf_Cs",
    "slug": "meteosurf-cs",
    "version": "1.0.0",
    "scheme": "meteosurfcs",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jordi.meteosurfcs",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "DDA9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Para ordenar los spots por distancia y registrar tus sesiones de surf y olas en el agua.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Para registrar la ruta GPS, olas y velocidad mientras surfeas en el agua.",
        "NSMotionUsageDescription": "Para detectar automáticamente cuándo coges una ola, los giros y contar las remadas con los sensores de movimiento.",
        "NSHealthShareUsageDescription": "Para leer tus pulsaciones cardíacas y saturación de oxígeno durante la sesión de surf en el agua con tu Apple Watch.",
        "NSHealthUpdateUsageDescription": "Para registrar la sesión de surf y las calorías activas en la app Salud de Apple.",
        "NSPhotoLibraryAddUsageDescription": "Para guardar clips de olas en tu carrete de fotos.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.jordi.meteosurfcs",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
